{
  "name": "agam-voice-agriculture",
  "private": true,
  "version": "2.0.0",
  "description": "AGAM — AI-Guided Voice-First Agriculture Platform for Farmers with NASA Satellite Telemetry & Groq LPU",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production tsx server.ts",
    "generate": "python3 scripts/generate_ui_kit.py",
    "website:build": "bun run --cwd website build || npm run build",
    "website:dev": "bun run --cwd website dev || npm run dev",
    "website:deploy": "bun run --cwd website deploy"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^11.4.0",
    "groq-sdk": "^0.15.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
