{
  "entities": {
    "FarmerProfile": {
      "title": "FarmerProfile",
      "description": "User profile for verified agricultural producers using AGAM.",
      "type": "object",
      "properties": {
        "phoneNumber": {
          "type": "string",
          "description": "Verified Indian phone number format."
        },
        "preferredLanguage": {
          "type": "string",
          "description": "Selected interface language code (e.g., en, ta, hi, te, kn, mr)."
        },
        "defaultDistrict": {
          "type": "string",
          "description": "Primary farming district ID."
        },
        "lastLoginAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of last login."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of registration."
        }
      },
      "required": ["phoneNumber", "preferredLanguage"]
    },
    "AdvisoryRecord": {
      "title": "AdvisoryRecord",
      "description": "Historical telemetry snapshot and rule-engine decision record.",
      "type": "object",
      "properties": {
        "districtId": {
          "type": "string",
          "description": "District unique identifier."
        },
        "districtName": {
          "type": "string",
          "description": "District display name."
        },
        "crop": {
          "type": "string",
          "description": "Cultivated crop."
        },
        "soilMoisture": {
          "type": "number",
          "description": "Measured root zone soil moisture percentage."
        },
        "rainForecast": {
          "type": "number",
          "description": "Expected precipitation in millimeters."
        },
        "riskLevel": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "Evaluated water stress risk level."
        },
        "irrigationNeeded": {
          "type": "boolean",
          "description": "Whether irrigation was triggered."
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp when recorded."
        }
      },
      "required": ["districtId", "soilMoisture", "rainForecast", "riskLevel", "irrigationNeeded", "timestamp"]
    },
    "DiseaseScanRecord": {
      "title": "DiseaseScanRecord",
      "description": "Diagnostics result from Gemini Vision and local remedy lookup.",
      "type": "object",
      "properties": {
        "diseaseLabel": {
          "type": "string",
          "enum": ["Leaf Blight", "Powdery Mildew", "Rust", "Bacterial Spot", "Healthy"],
          "description": "Verified diagnostic classification."
        },
        "remedy": {
          "type": "string",
          "description": "Prescribed curative action."
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp of diagnosis."
        }
      },
      "required": ["diseaseLabel", "remedy", "timestamp"]
    }
  },
  "firestore": {
    "/farmers/{farmerId}": {
      "schema": "FarmerProfile",
      "description": "Farmer profile indexed by phone number or UID."
    },
    "/farmers/{farmerId}/advisories/{advisoryId}": {
      "schema": "AdvisoryRecord",
      "description": "Advisory telemetry log history for the farmer."
    },
    "/farmers/{farmerId}/scans/{scanId}": {
      "schema": "DiseaseScanRecord",
      "description": "Crop foliage pathology scan history."
    }
  }
}
